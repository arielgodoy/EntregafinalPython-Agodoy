# DJANGO_CSRF_TRUSTED_ORIGINS=https://biblioteca.eltit.cl
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# DJANGO_BEHIND_HTTPS_PROXY=True

